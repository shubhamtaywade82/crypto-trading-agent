# MODE=paper | live
MODE=paper

# Binance API (required only for live)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Ollama (Local: http://127.0.0.1:11434, Cloud: https://ollama.com)
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
# Cloud API keys (rotate across multiple free credit accounts)
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=
OLLAMA_API_KEY_4=
OLLAMA_API_KEY_5=

# Multi-persona LLM research council: five specialist personas plus a portfolio chair analyze
# every closed 15m state. On by default.
LLM_COUNCIL=on
# A chair TRADE verdict becomes a real Signal — but only for a scenario the deterministic
# SetupEngine has already marked TRIGGERED, using that scenario's own entry/stop/target (the LLM
# never sets price levels). Still passes through RiskAgent, execution-quality checks and the
# kill-switch like any other signal. On by default; set to off to keep the council advisory-only
# (still logs every verdict) without touching LLM_COUNCIL.
LLM_COUNCIL_AUTOTRADE=on
# Minimum chair probability required before a TRADE verdict is converted into a Signal.
LLM_COUNCIL_MIN_PROBABILITY=0.65
# Each persona may use a different Ollama model; blank = OLLAMA_MODEL.
OLLAMA_TECHNICAL_MODEL=
OLLAMA_LIQUIDITY_MODEL=
OLLAMA_DERIVATIVES_MODEL=
OLLAMA_REGIME_MODEL=
OLLAMA_SKEPTIC_MODEL=
OLLAMA_CHAIR_MODEL=

# Risk limits (deterministic)
# MAX_LEVERAGE must match what your broker will accept. paper_exchange caps
# crypto perpetual leverage at the value the order carries — there is no
# server-side max by default. Binance USD-M allows up to 125x on BTCUSDT but
# anything above 20x is effectively a liquidation lottery.
MAX_LEVERAGE=10
MAX_EXPOSURE_PCT=80
RISK_PER_TRADE_PCT=1
MAX_DRAWDOWN_PCT=5
MIN_LIQ_BUFFER_ATR=2

# Extended risk engine, on by default. Sizing nets round-trip fees, slippage and funding out of
# the per-trade risk budget, floors to the exchange lot size, and adds per-symbol, BTC/ETH/alt
# cluster and gross exposure caps plus a circuit breaker:
# CAUTION at 50% of a limit (0.75x risk), REDUCED at 75% (0.5x), HALTED at 100% of daily loss or
# loss streak, EMERGENCY at 100% of MAX_DRAWDOWN_PCT. In MODE=live without PAPER_EXCHANGE_URL there
# is no trade journal, so only the drawdown limit is active (a warning is logged at start).
# RISK_ENGINE=on                # off = legacy RiskAgent sizing only (no fee netting, no exposure caps, no circuit breaker)
# MAX_DAILY_LOSS_PCT=3          # UTC-day loss, % of equity, that halts new entries
# MAX_LOSS_STREAK=4             # consecutive losing trades that halt new entries
# MAX_CONCURRENT_POSITIONS=4    # default: number of SYMBOLS
# MAX_SYMBOL_EXPOSURE_PCT=80    # per-symbol exposure cap, % of equity; default: MAX_EXPOSURE_PCT
# MAX_CORRELATED_EXPOSURE_PCT=80  # BTC / ETH / alt cluster cap, % of equity; default: MAX_EXPOSURE_PCT
# MIN_RR=0                      # minimum reward:risk; 0 disables the check
# TAKER_FEE_RATE=0.0004         # fee assumed per side when sizing (0.04%)
# SLIPPAGE_BUFFER_RATE=0.0002   # slippage assumed per side when sizing (0.02%)

# Market Data V2 (always on; public data only, read-only)
# Native 1m/5m/15m/1h/4h candles and derivatives positioning are TTL-cached.
# MARKET_DATA_KLINE_LIMIT=300
# MARKET_DATA_HISTORY_LIMIT=30
# MARKET_DATA_ORDERBOOK_DEPTH=20
# MARKET_DATA_MAX_CONCURRENCY=4
# MARKET_DATA_DERIVATIVES_PERIOD=1h
# MARKET_DATA_DERIVATIVES_TTL_MS=60000
# MARKET_DATA_1M_TTL_MS=15000
# MARKET_DATA_5M_TTL_MS=60000
# MARKET_DATA_15M_TTL_MS=60000
# MARKET_DATA_1H_TTL_MS=300000
# MARKET_DATA_4H_TTL_MS=900000

# Universe
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,AVAXUSDT

# Optional: back PAPER mode with the paper_exchange Rails broker over HTTP
# instead of the local in-memory PaperEngine. Leave both unset to keep the
# default local simulator. Start the broker first: docker compose up -d in
# /home/nemesis/projects/apps/paper_exchange (health check: GET :3100/up).
# Base URL of the broker.
# PAPER_EXCHANGE_URL=http://127.0.0.1:3100
# The agent's one shared account on the broker; created with 100000 margin only if missing, never reset.
# Required whenever PAPER_EXCHANGE_URL is set (no default; startup fails without it).
# PAPER_EXCHANGE_ACCOUNT_ID=crypto-agent

# Ops (on by default; see README "Ops: audit trail, Telegram alerts, kill-switch").
# AUDIT=on                       # off = stop appending a JSON line per decision step to EVENTS_PATH
# ALERTS=on                      # off = stop sending Telegram cards and the 00:05 UTC daily digest;
#                                 #       still needs TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID below to actually send
# STRUCT_LIQ=on                  # off = remove the STRUCT-LIQ-η agent from the fleet (shown paused)
# EVENTS_PATH=data/events.jsonl
# NOTIFICATIONS_PATH=data/notifications.json   # optional subscription JSON (classes, symbols, minSeverity)
# DECISIONS_PATH=data/decisions.jsonl          # append-only decision journal (evidence -> risk -> execution -> outcome)
# TELEGRAM_CHAT_ID=                            # destination chat id
# TELEGRAM_BOT_TOKEN=                          # shared bot token (fallback for both channels)
# TELEGRAM_TRADING_BOT_TOKEN=                  # TRADE and SIGNAL cards
# TELEGRAM_ALERTBOT_BOT_TOKEN=                 # SYSTEM and digest cards
# TELEGRAM_DRY_RUN=1                           # 1 = show the cards in the cockpit log instead of sending them
