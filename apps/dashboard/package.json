{
  "name": "@cta/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only web cockpit for crypto-trading-agent. Visualizes the existing trading engine — never replaces it.",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.19.2",
    "lightweight-charts": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.3.4"
  }
}
