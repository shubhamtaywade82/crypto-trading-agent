{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "outDir": "dist-server",
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "@cta-agent/*": ["../../src/*"]
    }
  },
  "include": ["server", "shared"]
}
